#!/usr/bin/env bash
# Bash-callable entry point for the code-graph CLI. The runner puts
# bench/cli on PATH so the agent can invoke `cg ...` directly.
# BENCH_PYTHON is set by the runner to the venv's python; falls back
# to system python3 if missing (won't have deps; will fail loudly).
exec "${BENCH_PYTHON:-python3}" -m bench.cli.cg "$@"
